# Fedora 41 (glibc 2.40): gera o .rpm para Fedora 41+ e openSUSE recentes.
FROM fedora:41
RUN dnf -y install gcc gcc-c++ make ca-certificates curl file git pkgconf-pkg-config xz zstd \
      python3 python3-devel python3-pip \
      webkit2gtk4.1-devel gtk3-devel librsvg2-devel libxdo-devel openssl-devel patchelf \
      rpm-build desktop-file-utils shared-mime-info \
    && dnf clean all
ENV RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ARG TAURI_CLI=2.11.5
RUN cargo install tauri-cli --version =${TAURI_CLI} --locked && rm -rf /opt/cargo/registry
