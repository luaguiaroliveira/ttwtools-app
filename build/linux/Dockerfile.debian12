# Debian 12 (glibc 2.36): gera o .deb e o .tar.gz que rodam em Debian 12+, Ubuntu 24.04+ e derivados.
FROM debian:12
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl file git pkg-config xz-utils zstd \
      python3 python3-dev python3-venv \
      libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev libxdo-dev libssl-dev patchelf \
      dpkg-dev desktop-file-utils shared-mime-info \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ARG TAURI_CLI=2.11.5
RUN cargo install tauri-cli --version =${TAURI_CLI} --locked && rm -rf /opt/cargo/registry
